<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <AssemblyTitle>VSCMount</AssemblyTitle>
        <Company>Eric Zimmerman</Company>
        <Product>VSCMount</Product>
        <Description>Mount VSCs easily</Description>
        <Copyright>Eric Zimmerman</Copyright>
        <LangVersion>10</LangVersion>
        <Version>2026.5.0</Version>
    </PropertyGroup>
    <PropertyGroup>
        <ApplicationIcon>Window.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="System.CommandLine" Version="2.0.7" />
        
        <PackageReference Include="System.Management" Version="10.0.7" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Costura.Fody" Version="6.0.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Exceptionless" Version="6.1.0" />
        <PackageReference Include="Serilog" Version="4.3.1" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="ServiceStack.Text" Version="10.0.6" />
        <PackageReference Include="WmiLight" Version="7.2.0" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="Window.ico"/>
    </ItemGroup>
</Project>