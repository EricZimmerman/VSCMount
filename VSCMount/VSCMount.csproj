<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyTitle>VSCMount</AssemblyTitle>
        <Company>Eric Zimmerman</Company>
        <Product>VSCMount</Product>
        <Description>Mount VSCs easily</Description>
        <Copyright>Eric R. Zimmerman 2027</Copyright>
        <LangVersion>10</LangVersion>
        <Version>2026.10.0</Version>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <PropertyGroup>
        <ApplicationIcon>Window.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="System.CommandLine" Version="2.0.13" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Costura.Fody" Version="6.2.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Exceptionless" Version="6.2.0" />
        <PackageReference Include="Fody" Version="6.9.3">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="WmiLight" Version="4.0.0" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="Window.ico"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="VSCMount.Test" />
    </ItemGroup>
</Project>
